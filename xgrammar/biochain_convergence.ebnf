# BioChain CONVERGENCE — vLLM/xgrammar constrained decoding grammar (GBNF)
# Constrains ∮ states, ⊳ trajectories, ⊳⚠ risks, ⚡ flags, ⊕⊳ monitors.
# Pathway-sorted layout. Model chooses clinical reasoning — grammar ensures structure.

root ::= conv-pathways conv-cross?

# --- PATHWAY-SORTED CONVERGENCE BLOCKS ---
conv-pathways ::= conv-pathway+
conv-pathway ::= "::conv_pathway" ws ident "\n" conv-refs? conv-body
conv-refs ::= "::conv_refs" ws (ref-list | "—") "\n"
ref-list ::= node-ref (ws node-ref)*
conv-body ::= conv-state+ trajectory+ risk* flag* monitor*

# --- CROSS-PATHWAY ---
conv-cross ::= "::conv_cross" "\n" conv-state* trajectory* risk* flag* monitor*

# --- ∮ CONVERGENCE STATE ---
conv-state ::= "∮(" node-ref ")=" v-triple "→" diagnosis "\n"
v-triple ::= "v_past:" v-state ",v_current:" v-state ",v_meta:" v-state
v-state ::= arrow "(" ident ")"
diagnosis ::= "converging_low" | "converging_high" | "converging_norm" | "divergent" | "contested" | "unstable" | "locked" | "breaking" | "degenerating"

# --- ⊳ TRAJECTORY ---
trajectory ::= "⊳(" node-ref ",+" duration ")=" arrow "(" rationale ")" ws confidence "\n"
rationale ::= force ("," force)*
force ::= force-type ":" ident
force-type ::= "attractor" | "momentum" | "drive" | "loop" | "Δ_cascade" | "pool" | "fate" | "behavior" | "window" | "enzyme" | "aggregate" | "aging"
confidence ::= "confidence:" conf-level
conf-level ::= "high" | "moderate" | "low"

# --- ⊳⚠ RISK ---
risk ::= "⊳⚠(" risk-name ")=" risk-detail "\n"
risk-name ::= ident
risk-detail ::= "target:" node-ref ",distance:" proximity ",window:" duration ",reversible_before:" yn ",reversible_after:" yn ",accelerators:" factor-list ",decelerators:" factor-list dev-window?
proximity ::= "close" | "moderate" | "distant"
yn ::= "yes" | "difficult" | "no"
factor-list ::= factor ("+" factor)*
factor ::= ident
dev-window ::= ",dev_window:" window-status
window-status ::= "active" | "closing" | "closed"

# --- ⚡ FLAGS ---
flag ::= flag-allo | flag-resist | flag-diverge | flag-unstable | flag-lock | flag-cascade | flag-fate | flag-pool | flag-behavior | flag-dev | flag-enzyme | flag-aggregate | flag-aging

flag-allo ::= "⚡allo:σ̃{" type ":" code "@" region "}(baseline:" ident "→" ident ")" "\n"

flag-resist ::= "⚡resist:Δ{" type ":" code "@" region "}" ident " opposed by σ̃{" type ":" code "@" region "}(baseline:" ident ") unlocks_with:" unlock "\n"

flag-diverge ::= "⚡diverge:trend(v_past:" ident ")=" ident " ≠ σ̃(" ident ")=" ident "\n"

flag-unstable ::= "⚡unstable:v_past≠v_current≠v_meta for {" type ":" code "@" region "}" "\n"

flag-lock ::= "⚡lock:⊲̃{" ident "}=" ident " reversible:" yn " unlocks_with:" unlock "\n"

flag-cascade ::= "⚡cascade:⊟" ident "[position:" rank ",next_τ:" duration "]" "\n"
rank ::= "0" | "1" | "2" | "3"

flag-fate ::= "⚡fate:{" type ":" code "@" region "}" ident "→" ident "[τ:" duration "]" "\n"

flag-pool ::= "⚡pool:{V:" code "@" region "}=" ident "(" ident ")" "\n"

flag-behavior ::= "⚡behavior:{B.beh:" code "@behavior}=" ident "(" ident ")" "\n"

flag-dev ::= "⚡dev:⊗̃[" window "](" ident ") disrupted_by:" ident " urgency:" urgency "\n"
urgency ::= "low" | "moderate" | "high" | "critical"

flag-enzyme ::= "⚡enzyme:{E:" code "@" region "}=" ident "(" ident ")" "\n"

flag-aggregate ::= "⚡aggregate:{P.agg:" code "@" region "}=" ident "(stage:" ident ",propagation:" ident ")" "\n"

flag-aging ::= "⚡aging:" node-ref " degeneration_rate exceeds ⊗̃[" window "] program" "\n"

# --- UNLOCK ---
unlock ::= unlock-condition | "none"
unlock-condition ::= "⊗(" condition (logic condition)* ")[sustained>" duration "]"
condition ::= neg? node-ref ">=" arrow
neg ::= "¬"
logic ::= "∧" | "∨"

# --- ⊕⊳ MONITORING ---
monitor ::= "⊕⊳" ws measurement ws "→" ws monitor-target ws "(" tracking-note ")" "\n"
measurement ::= [a-zA-Z_][a-zA-Z0-9_]*
monitor-target ::= flag-ref | trajectory-ref
flag-ref ::= "⚡" ident ":" ident
trajectory-ref ::= "⊳(" node-ref ",+" duration ")"
tracking-note ::= [a-zA-Z0-9_ ,+=-]+

# --- WINDOW (for dev flags and aging flags) ---
window ::= age-range | condition-win | cumulative | congenital | aging-win
age-range ::= age "–" age
condition-win ::= "after:" ident ":" duration
cumulative ::= "cumulative:" ident
congenital ::= "0yr–∞"
aging-win ::= age "–∞"
age ::= [0-9]+ "yr"

# --- DURATION ---
duration ::= dur-num dur-unit
dur-num ::= [0-9]+
dur-unit ::= "ms" | "s" | "min" | "h" | "d" | "wk" | "mo" | "yr"

# --- STATE ARROWS ---
arrow ::= "++" | "+" | "=" | "~" | "-" | "--" | "X" | "*"

# --- NODE REFERENCE (full-form, matches BASE) ---
node-ref ::= "{" type ":" code "@" region "}"
type ::= struct-type | chem-type | elec-type | meta-mtype
chem-type ::= ligand-type | "R" | "Gp" | "2m" | "K" | "Ph" | "NR" | "TF" | "G" | "T" | "E" | "V"
ligand-type ::= "L.nt" | "L.h" | "L.p" | "L.cb" | "L.ni" | "L.ns" | "L.mb"
elec-type ::= "E.v" | "E.lf" | "E.gj" | "Ch" | "Ch.vg" | "Ch.mec" | "Ch.trp"
meta-mtype ::= "M.atp" | "M.glc" | "M.ros" | "M.o2" | "Mt" | "M:" ident
struct-type ::= "N.pyr" | "N.da" | "N.5ht" | "N.gaba" | "N.gran" | "N.glia.mg" | "N.glia.as" | "N.glia" | "N.ent" | "N.eec" | "N.icc" | "B.gut" | "B.bbb" | "B.beh" | "P.agg" | "P.oligo" | "N"

code ::= code-char+
code-char ::= [a-zA-Z0-9_.] | "-" | "α" | "β" | "γ" | "δ" | "ε" | "κ" | "τ"

region ::= cns-region | bg-region | bs-region | sp-region | ens-region | endo-region | periph-region | "behavior"
cns-region ::= "PVN" | "LC" | "DRN" | "VTA" | "NAc" | "AMY" | "BLA" | "CeA" | "HPC" | "PFC" | "ACC" | "INS" | "SCN" | "PIT" | "PAG" | "RVM" | "EC" | "SN" | "LH" | "BST" | "POA" | "DG" | "thalamus" | "NBM"
bg-region ::= "striatum" | "GPi" | "GPe" | "STN"
bs-region ::= "brainstem" | "pons" | "SLD"
sp-region ::= "spinal"
ens-region ::= "ENS" | "GUT" | "VAG" | "NTS" | "DMV" | "AP"
endo-region ::= "ARC" | "ADR" | "THYROID" | "GONAD"
periph-region ::= "LIVER" | "systemic" | "plasma" | "kidney" | "cardiac"

# --- PRIMITIVES ---
ident ::= [a-zA-Z_][a-zA-Z0-9_.:-]*
ws ::= " "+
