<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NeuroGateway.Calibration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.*" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
    <PackageReference Include="Spectre.Console" Version="0.49.*" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.2.0-preview.1.26063.2" />
    <PackageReference Include="OllamaSharp" Version="5.1.12" />
    <PackageReference Include="Anthropic" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuroGateway.Service\NeuroGateway.Service.csproj" />
    <ProjectReference Include="..\NeuroGateway.Repository\NeuroGateway.Repository.csproj" />
    <ProjectReference Include="..\NeuroGateway.Models\NeuroGateway.Models.csproj" />
    <ProjectReference Include="..\NeuroGateway.AnalysisFramework\NeuroGateway.AnalysisFramework.csproj" />
    <ProjectReference Include="..\NeuroGateway.AgentFramework\NeuroGateway.AgentFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Prompts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
