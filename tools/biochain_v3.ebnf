enzyme_deiodinase_D3 ::= "{E:deiodinase_D3" state? "@" region "}→{L.h:rT3" state? "@" region "}"
enzyme_GLS ::= "{E:GLS" state? "@" region "}→{L.nt:GLU" state? "@" region "}"
enzyme_GS ::= "{E:GS" state? "@" region "}→{L.nt:GLN" state? "@" region "}"
enzyme_nNOS ::= "{E:nNOS" state? "@" region "}→{L.gas:NO" state? "@" region "}"
enzyme_iNOS ::= "{E:iNOS" state? "@" region "}→{L.gas:NO" state? "@" region "}"
enzyme_eNOS ::= "{E:eNOS" state? "@" region "}→{L.gas:NO" state? "@" region "}"
enzyme_AANAT ::= "{E:AANAT" state? "@" region "}→{L.nt:NAS" state? "@" region "}"
enzyme_ASMT ::= "{E:ASMT" state? "@" region "}→{L.h:melatonin" state? "@" region "}"
enzyme_BACE1 ::= "{E:BACE1" state? "@" region "}→{P.agg:amyloid-β" state? "@" region "}"
enzyme_gamma_secretase ::= "{E:γ-secretase" state? "@" region "}→{P.agg:amyloid-β" state? "@" region "}"
enzyme_11beta_HSD2 ::= "{E:11β-HSD2" state? "@" region "}→⊘"
enzyme_AChE ::= "{E:AChE" state? "@" region "}→⊘"
enzyme_ADH ::= "{E:ADH" state? "@" region "}→⊘"
enzyme_ALDH2 ::= "{E:ALDH2" state? "@" region "}→⊘"
enzyme_BChE ::= "{E:BChE" state? "@" region "}→⊘"
enzyme_COMT ::= "{E:COMT" state? "@" region "}→⊘"
enzyme_COX1 ::= "{E:COX1" state? "@" region "}→⊘"
enzyme_COX2 ::= "{E:COX2" state? "@" region "}→⊘"
enzyme_CYP3A4 ::= "{E:CYP3A4" state? "@" region "}→⊘"
enzyme_FAAH ::= "{E:FAAH" state? "@" region "}→⊘"
enzyme_MAGL ::= "{E:MAGL" state? "@" region "}→⊘"
enzyme_MAO_A ::= "{E:MAO-A" state? "@" region "}→⊘"
enzyme_MAO_B ::= "{E:MAO-B" state? "@" region "}→⊘"
enzyme_chain ::= enzyme_TH | enzyme_DDC | enzyme_DBH | enzyme_TPH1 | enzyme_TPH2 | enzyme_GAD67 | enzyme_GAD65 | enzyme_ChAT | enzyme_IDO | enzyme_5alpha_reductase | enzyme_CYP19A1 | enzyme_deiodinase_D2 | enzyme_deiodinase_D1 | enzyme_deiodinase_D3 | enzyme_GLS | enzyme_GS | enzyme_nNOS | enzyme_iNOS | enzyme_eNOS | enzyme_AANAT | enzyme_ASMT | enzyme_BACE1 | enzyme_gamma_secretase | enzyme_11beta_HSD2 | enzyme_AChE | enzyme_ADH | enzyme_ALDH2 | enzyme_BChE | enzyme_COMT | enzyme_COX1 | enzyme_COX2 | enzyme_CYP3A4 | enzyme_FAAH | enzyme_MAGL | enzyme_MAO_A | enzyme_MAO_B

# ── TRANSPORTER-SUBSTRATE (knowledge graph encoded) ──

transport_DAT ::= "{T:DAT" state? "@" region "}|>{V:ves_" ("DA") "@" region "}"
transport_SERT ::= "{T:SERT" state? "@" region "}|>{V:ves_" ("5HT") "@" region "}"
transport_NET ::= "{T:NET" state? "@" region "}|>{V:ves_" ("NE") "@" region "}"
transport_VMAT2 ::= "{T:VMAT2" state? "@" region "}|>{V:ves_" ("DA" | "5HT" | "NE") "@" region "}"
transport_LAT1 ::= "{T:LAT1" state? "@" region "}|>{V:ves_" ("TRP") "@" region "}"
transport_EAAT2 ::= "{T:EAAT2" state? "@" region "}|>{V:ves_" ("GLU") "@" region "}"
transport_GAT1 ::= "{T:GAT1" state? "@" region "}|>{V:ves_" ("GABA") "@" region "}"
transport_SN1 ::= "{T:SN1" state? "@" region "}|>{V:ves_" ("GLN") "@" region "}"
recycling_chain ::= transport_DAT | transport_SERT | transport_NET | transport_VMAT2 | transport_LAT1 | transport_EAAT2 | transport_GAT1 | transport_SN1

# ── GENERIC (unconstrained parts) ──
code ::= [A-Za-z0-9α-ωβ._/-]+
second_messenger ::= "cAMP" | "IP3" | "DAG" | "Ca²⁺" | "Cl⁻" | "Na⁺" | "K⁺" | "cGMP"
rest_of_chain ::= [^\n]+

integration ::= "∫{" code "@" region "}←(" input_list ")→" code "@" region ":" mode "\n"
input_list ::= input ("," input)*
input ::= code "@" region ":" sign
sign ::= "+" | "-" | "×"
mode ::= "thr" | "rate" | "burst" | "tonic"

protocol ::= "{" code "@" region "}⊲{" [^}]+ "}[" pterms "]\n"
pterms ::= pterm (" " pterm)*
pterm ::= "exc" | "inh" | "mod" | "fast" | "slow" | "tonic" | "syn" | "vol" | "gap" | "para" | gate_cond
gate_cond ::= "{" code "@" region ">=" state_val "}"

conditional ::= "⊗(" condition+ ")⟹" effect "\n"
condition ::= "¬"? "{" code "@" region "}>=" state_val
effect ::= "{" code "@" region "}:" effect_type
effect_type ::= "pass" | "block" | "amplify" | "apoptosis" | "switch:" code

composite ::= "◈" code "=" comp_ref ("+" comp_ref)* "\n"
comp_ref ::= "{" code "@" region "}"

dysreg ::= "⚡" dysreg_type ":" [^(]+ "(" [^)]+ ")\n"
dysreg_type ::= "sus" | "dep" | "exc" | "shunt" | "osc" | "res" | "acc" | "lock" | "sat"

observable ::= "⊕ " code " → " obs_refs " (" obs_rel ")\n"
obs_refs ::= "{" code "@" region "}" ("," "{" code "@" region "}")*
obs_rel ::= "direct" | "proxy" | "ratio" | "activity" | "metabolite" | "autonomic"