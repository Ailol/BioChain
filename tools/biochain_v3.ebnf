enzyme_TPH2 ::= "{E:TPH2" state? "@" region "}→{L.nt:5HT" state? "@" region "}"
enzyme_GAD67 ::= "{E:GAD67" state? "@" region "}→{L.nt:GABA" state? "@" region "}"
enzyme_GAD65 ::= "{E:GAD65" state? "@" region "}→{L.nt:GABA" state? "@" region "}"
enzyme_ChAT ::= "{E:ChAT" state? "@" region "}→{L.nt:ACh" state? "@" region "}"
enzyme_IDO ::= "{E:IDO" state? "@" region "}→{L.ni:KYN" state? "@" region "}"
enzyme_5alpha_reductase ::= "{E:5α-reductase" state? "@" region "}→{L.ns:allopregnanolone" state? "@" region "}"
enzyme_CYP19A1 ::= "{E:CYP19A1" state? "@" region "}→{L.h:estradiol" state? "@" region "}"
enzyme_deiodinase_D2 ::= "{E:deiodinase_D2" state? "@" region "}→{L.h:T3" state? "@" region "}"
