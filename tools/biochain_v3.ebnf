# ── ENZYME-PRODUCT (knowledge graph encoded) ──

enzyme_TH ::= "{E:TH" state? "@" region "}→{L.nt:DA" state? "@" region "}"
enzyme_DDC ::= "{E:DDC" state? "@" region "}→{L.nt:DA" state? "@" region "}"
enzyme_DBH ::= "{E:DBH" state? "@" region "}→{L.nt:NE" state? "@" region "}"
