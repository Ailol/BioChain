# MultiAgentAiMcp Environment Configuration
# Copy this to .env and customize

# ===========================================
# Environment Flag
# ===========================================
# "Development" = local Docker postgres (DEVELOPMENT_DB)
# "Production"  = Supabase cloud DB (PRODUCTION_DB)
ENVIRONMENT=Development

# ===========================================
# Database Connection Strings
# ===========================================
# Local Docker postgres (used when ENVIRONMENT=Development)
DEVELOPMENT_DB=Host=biochain-postgres;Port=5432;Database=personality;Username=postgres;Password=postgres

# Supabase cloud DB (used when ENVIRONMENT=Production)
PRODUCTION_DB=Host=your-supabase-host;Port=6543;Database=postgres;Username=postgres.xxx;Password=xxx;SSL Mode=Require;Trust Server Certificate=true;Timeout=30;Command Timeout=60

# ===========================================
# LLM Provider Configuration
# ===========================================
# Three independent provider slots: Orchestrator, AgentFramework, Embedding.
# Each needs Endpoint + Model. Backend is auto-detected from Endpoint/ApiKey:
#   - ApiKey starts with "sk-ant" → Anthropic
#   - No Endpoint → OpenAI (official endpoint)
#   - Endpoint port :11434 → Ollama (native client)
#   - Everything else → OpenAI-compatible (vLLM, RunPod, etc.)
#
# Non-secret config (endpoints, models) goes in appsettings.json.
# API keys (secrets) go here in .env — never committed to git.

# --- API Keys (only set for cloud providers that need them) ---

# Llm__AgentFramework__ApiKey=rpa_XXXXXXXXXXXX
# Llm__Orchestrator__ApiKey=sk-ant-XXXXXXXXXXXX
# Llm__Embedding__ApiKey=

# --- Override per-purpose config via env vars (optional, overrides appsettings.json) ---

# Llm__Orchestrator__Endpoint=http://localhost:11434
# Llm__Orchestrator__Model=qwen-3-vl-fast

# Llm__AgentFramework__Endpoint=https://api.runpod.ai/v2/{endpoint_id}/openai/v1
# Llm__AgentFramework__Model=Qwen/Qwen3-Next-80B-A3B-Instruct-FP8

# Llm__Embedding__Endpoint=http://localhost:8000
# Llm__Embedding__Model=Qwen/Qwen3-Embedding-8B

# ===========================================
# Docker Compose Usage
# ===========================================
# docker compose up -d --build               # Build and start
# docker compose logs -f mcp                 # View MCP server logs
# docker compose down                        # Stop all
