# MultiAgentAiMcp Docker Environment
# Copy this to .env and customize

# ===========================================
# Ollama Configuration
# ===========================================
# Option 1: Local Docker (host machine)
# OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Option 2: Tailscale (for cloud deployment accessing home Ollama)
OLLAMA_ENDPOINT=http://100.104.149.87:11434

# Model name (must match `ollama list` output)
OLLAMA_MODEL=qwen3-vl:30b-a3b-instruct-q8_0

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_PASSWORD=postgres

# ===========================================
# MCP Server
# ===========================================
ASPNETCORE_ENVIRONMENT=Production

# ===========================================
# OpenClaw (for WhatsApp/Telegram integration)
# ===========================================
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===========================================
# Railway Deployment (optional)
# ===========================================
# Set in GitHub Secrets, not here
# RAILWAY_TOKEN=xxxxx
