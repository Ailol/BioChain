# MultiAgentAiMcp Environment Configuration
# Copy this to .env and customize

# ===========================================
# Environment Flag
# ===========================================
# "Development" = local Docker postgres (DEVELOPMENT_DB)
# "Production"  = Supabase cloud DB (PRODUCTION_DB)
ENVIRONMENT=Development

# ===========================================
# Database Connection Strings
# ===========================================
# Local Docker postgres (used when ENVIRONMENT=Development)
DEVELOPMENT_DB=Host=multiagent-postgres;Port=5432;Database=personality;Username=postgres;Password=postgres

# Supabase cloud DB (used when ENVIRONMENT=Production)
PRODUCTION_DB=Host=your-supabase-host;Port=5432;Database=postgres;Username=postgres.xxx;Password=xxx;SSL Mode=Require;Trust Server Certificate=true;Timeout=30;Command Timeout=60

# ===========================================
# LLM Backend (required)
# ===========================================
# Backend: "Vllm" or "Ollama"
Llm__Backend=Vllm

# Chat endpoint (required)
# vLLM: http://localhost:8000
# Ollama: http://localhost:11434
Llm__ChatEndpoint=http://localhost:8000

# Optional: separate embedding endpoint (defaults to ChatEndpoint)
# Llm__EmbeddingEndpoint=http://localhost:8001

# Model names (required — must match exactly)
Llm__ThinkingModel=cyankiwi/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
Llm__InstructModel=cyankiwi/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
Llm__EmbeddingModel=qwen3-embedding

# Max parallel agent calls (default: 3)
Llm__MaxParallelAgents=3

# ===========================================
# Docker Compose Usage
# ===========================================
# Development (local postgres):  docker compose -f McpServer/docker-compose.yml --profile dev up -d
# Production  (Supabase):        ENVIRONMENT=Production docker compose -f McpServer/docker-compose.yml --profile prod up -d
# Or flip the ENVIRONMENT flag in .env and use the matching profile.
